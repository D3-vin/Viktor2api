{
  "manifest_version": 3,
  "name": "Viktor2api",
  "version": "1.1.0",
  "description": "Reads Slack tokens, cookies and Viktor JWT for config.yaml",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://app.slack.com/*",
    "https://slack.com/*",
    "https://slack.com/api/*",
    "https://app.viktor.com/*",
    "https://*.viktor.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Viktor2api",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
